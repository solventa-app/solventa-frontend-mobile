// Entorno obligatorio de desarrollo (docs/entorno-local.md). El CI construye y usa esta misma definición.
{
  "name": "Solventa mobile",
  "build": {
    "dockerfile": "Dockerfile",
    // amd64 siempre, también en Mac con chip M (el Android SDK no tiene binarios para Linux ARM).
    "options": ["--platform=linux/amd64"],
    // La imagen publicada por imagen-devcontainer.yml evita compilarla desde cero la primera vez.
    "cacheFrom": "ghcr.io/solventa-app/solventa-frontend-mobile-dev:latest"
  },
  "runArgs": [
    "--platform=linux/amd64",
    // Docker Desktop (Windows y Mac) ya resuelve host.docker.internal; en Linux lo agrega esta línea.
    "--add-host=host.docker.internal:host-gateway"
  ],
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "containerEnv": {
    // flutter y adb usan el servidor de adb de tu máquina, que ve el emulador y el teléfono por USB.
    // En tu máquina: Mac, adb start-server; Windows y Linux, adb kill-server && adb -a nodaemon server start
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037",
    // El vigilante de archivos de Gradle falla bajo emulación ("Couldn't poll for events").
    "GRADLE_OPTS": "-Dorg.gradle.vfs.watch=false",
    // El profiler de Dart interrumpe las copias de archivos; bajo Rosetta (Mac con chip M) no se reintentan y el
    // build del APK cae con "Unexpected EINTR errno". Durante un build el profiler no sirve, así que no cuesta nada.
    "DART_VM_OPTIONS": "--no-profiler"
  },
  "mounts": [
    "source=solventa-mobile-gradle,target=/home/dev/.gradle,type=volume",
    "source=solventa-mobile-pub,target=/home/dev/.pub-cache,type=volume"
  ],
  "postCreateCommand": "tool/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.lineLength": 80,
        "[dart]": {
          "editor.formatOnSave": true,
          "editor.formatOnType": true,
          "editor.rulers": [80],
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
