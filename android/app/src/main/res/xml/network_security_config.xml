<?xml version="1.0" encoding="utf-8"?>
<!-- Release (dev y prod): todo el tráfico va por https y solo confía en las CA del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
